import {
  "moonbitlang/async",
  "vectie/moonclaw/cmd/daemon",
  "vectie/moonclaw/cmd/server",
  "vectie/moonclaw/internal/backtrace",
  "vectie/moonclaw/internal/buildinfo",
  "vectie/moonlib/os",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  overrides: [ "vectie/moonclaw/internal/abort" ],
  link: { "native": { "cc-link-flags": "-pthread -ldl" } },
)
