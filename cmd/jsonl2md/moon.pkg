import {
  "moonbitlang/async",
  "vectie/moonlib/os",
  "vectie/moonclaw/internal/backtrace",
  "vectie/moonlib/fsx",
  "vectie/moonlib/pathx",
  "vectie/moonclaw/internal/git",
  "moonbitlang/x/time",
  "moonbitlang/regexp",
  "vectie/moonclaw/event",
  "vectie/moonclaw/ai",
  "vectie/moonclaw/clock",
  "moonbitlang/core/cmp",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/core/test",
}

supported_targets = "native"

import {
  "vectie/moonclaw/internal/mock",
  "vectie/moonclaw/internal/pino",
} for "wbtest"

pkgtype(kind: "executable")

options(
  overrides: [ "vectie/moonclaw/internal/abort" ],
)
