import {
  "vectie/moonlib/errno",
  "vectie/moonlib/c",
  "moonbitlang/core/encoding/utf8" @encoding/utf8,
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/core/test",
}

supported_targets = "native"

import {
  "vectie/moonlib/spawn",
  "moonbitlang/async",
  "vectie/moonclaw/internal/mock",
} for "test"

options(
  "native-stub": [ "os.c" ],
  targets: {
    "os_debug_test.mbt": [ "debug" ],
    "os_release_test.mbt": [ "release" ],
  },
)
