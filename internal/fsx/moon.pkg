import {
  "moonbitlang/async/fs",
  "vectie/moonlib/pathx",
  "moonbitlang/async/io",
  "vectie/moonlib/errno",
  "vectie/moonlib/os",
  "moonbitlang/async/os_error",
  "moonbitlang/core/encoding/utf8" @encoding/utf8,
  "moonbitlang/core/json",
  "moonbitlang/core/test",
}

supported_targets = "native"

import {
  "moonbitlang/async",
  "vectie/moonclaw/internal/mock",
  "vectie/moonlib/spawn",
  "moonbitlang/async/process",
  "vectie/moonclaw/internal/signal",
} for "test"

options(
  "native-stub": [
    "stat.c",
    "mkdtemp.c",
    "readlink.c",
    "lock.c",
    "truncate.c",
    "rename.c",
  ],
)
